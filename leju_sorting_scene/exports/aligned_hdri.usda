#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def Xform "Leju" (
        prepend references = @./aligned_asset.usda@</Leju>
    )
    {
    }

    def PhysicsScene "PhysicsScene"
    {
        vector3f physics:gravityDirection = (0, 0, -1)
        float physics:gravityMagnitude = 9.81
    }

    def DomeLight "Environment"
    {
        color3f inputs:color = (0.89, 0.94, 1)
        float inputs:intensity = 2200
        asset inputs:texture:file = @./textures/studio_small_09_1k.hdr@
        token inputs:texture:format = "latlong"
    }
}

