#usda 1.0
(
    defaultPrim = "Leju"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Leju" (
    customData = {
        string materialProvenance = "RGB-derived approximate PBR. Base color has approximate illumination suppression; roughness/normal are estimates, not measured intrinsic properties."
        string mechanism = "Static scene. Motor, belt, cables and small hardware are visual geometry; no actuator or cable dynamics."
    }
    prepend references = @./aligned_geometry.usdc@</Leju>
)
{
    def "PhysicsMaterials"
    {
        def Material "Contact" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.5
            float physics:restitution = 0.02
            float physics:staticFriction = 0.7
        }
    }

    over "_materials"
    {
        over "PBR_Carpet"
        {
            token outputs:surface.connect = </Leju/_materials/PBR_Carpet/RGB_PBR_Surface.outputs:surface>

            def Shader "RGB_PBR_Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </Leju/_materials/PBR_Carpet/RGB_PBR_basecolor.outputs:rgb>
                float inputs:metallic = 0
                float inputs:metallic.connect = </Leju/_materials/PBR_Carpet/RGB_PBR_metallic.outputs:r>
                normal3f inputs:normal.connect = </Leju/_materials/PBR_Carpet/RGB_PBR_normal.outputs:rgb>
                float inputs:roughness = 0.5
                float inputs:roughness.connect = </Leju/_materials/PBR_Carpet/RGB_PBR_roughness.outputs:r>
                token outputs:surface
            }

            def Shader "RGB_PBR_UV"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "RGB_PBR_basecolor"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/carpet_basecolor.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </Leju/_materials/PBR_Carpet/RGB_PBR_UV.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float outputs:r
                float3 outputs:rgb
            }

            def Shader "RGB_PBR_roughness"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/carpet_roughness.png@
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </Leju/_materials/PBR_Carpet/RGB_PBR_UV.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float outputs:r
                float3 outputs:rgb
            }

            def Shader "RGB_PBR_metallic"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/carpet_metallic.png@
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </Leju/_materials/PBR_Carpet/RGB_PBR_UV.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float outputs:r
                float3 outputs:rgb
            }

            def Shader "RGB_PBR_normal"
            {
                uniform token info:id = "UsdUVTexture"
                float4 inputs:bias = (-0.45, -0.45, -1, 0)
                asset inputs:file = @./textures/carpet_normal.png@
                float4 inputs:scale = (0.9, 0.9, 2, 1)
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </Leju/_materials/PBR_Carpet/RGB_PBR_UV.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float outputs:r
                float3 outputs:rgb
            }
        }

