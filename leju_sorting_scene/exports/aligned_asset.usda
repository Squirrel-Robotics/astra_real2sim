            }
        )
        {
            float xformOp:rotateZ = -111.689606
            double3 xformOp:translate = (0.8557772637043971, 0.20025861969637387, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ"]
