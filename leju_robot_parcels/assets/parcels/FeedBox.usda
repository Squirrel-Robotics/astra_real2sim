    def Scope "_materials"
    {
        def Material "Exposed_cardboard_edge"
        {
            token outputs:surface.connect = </Asset/_materials/Exposed_cardboard_edge/Principled_BSDF.outputs:surface>
            custom string userProperties:blender:data_name = "Exposed cardboard edge"

            def Shader "Principled_BSDF"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:clearcoat = 0
                float inputs:clearcoatRoughness = 0.03
                color3f inputs:diffuseColor = (0.51, 0.34, 0.17)
                float inputs:ior = 1.5
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.91
                float inputs:specular = 0.5
                token outputs:surface
            }
        }

        def Material "Printed_dark_ink"
