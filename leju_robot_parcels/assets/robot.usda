            int physxArticulation:solverPositionIterationCount = 16
            int physxArticulation:solverVelocityIterationCount = 4
        }
        variantSet "Physics" = {
            "None" (
                prepend references = @configuration/robot_base.usd@
            ) {
                over "joints" (
                    active = false
                )
                {
                }

            }
            "PhysX" (
                prepend payload = @configuration/robot_physics.usd@
            ) {

