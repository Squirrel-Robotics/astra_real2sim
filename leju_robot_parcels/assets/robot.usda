    def "Looks"
    {
        def Material "RobotSilver"
        {
            token outputs:surface.connect = </Leju5WRevo2/Looks/RobotSilver/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.19, 0.205, 0.22)
                float inputs:metallic = 0.9
                float inputs:roughness = 0.48
                token outputs:surface
            }
        }

        def Material "HandBlack"
