    def "Looks"
    {
        def Material "visual_material"
        {
            token outputs:surface.connect = </World/Looks/visual_material/shader.outputs:surface>

            def Shader "shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                float3 inputs:diffuseColor = (0.42, 0.255, 0.12)
                token outputs:surface
            }
        }
    }

    def Material "ParcelContact" (
        prepend apiSchemas = ["PhysicsMaterialAPI"]
    )
    {
        float physics:dynamicFriction = 0.7
        float physics:restitution = 0.02
        float physics:staticFriction = 0.9
    }

    def "Materials"
    {
        def Material "LabelWhite"
        {
            token outputs:surface.connect = </World/Materials/LabelWhite/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.82, 0.81, 0.76)
                float inputs:roughness = 0.75
                token outputs:surface
            }
        }

        def Material "BarcodeBlack"
        {
            token outputs:surface.connect = </World/Materials/BarcodeBlack/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.015, 0.016, 0.018)
                float inputs:roughness = 0.75
                token outputs:surface
            }
        }
    }
